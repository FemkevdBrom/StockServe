@page
@model StockServe.Pages.BestellijstModel
@{
}
<div class="container-fluid bg-dark text-light p-3" style="height: 100vh;">
    <div class="row h-100">
        <!-- Sidebar -->
        <div class="col-md-3 bg-secondary text-center rounded p-3">
            <h2>Menu</h2>
            <div class="d-grid gap-2 my-3">
                <button class="btn btn-light" onclick="location.href='VoorraadDashbord'">Voorraad</button>
                <button class="btn btn-light" onclick="location.href='Bestellijst'">Bestellijst</button>
                <button class="btn btn-light" onclick="location.href='bezorgLijst'">Word Bezorgt</button>
                <button class="btn btn-light" onclick="location.href='VoorraadAanpassen'">Pas Voorraad Aan</button>
            </div>
        </div>


        <!-- Main Content -->
        <div class="col-md-9 bg-dark rounded p-3">
            <div class="row fw-bold text-light border-bottom pb-2 mb-3">
                <div class="col">Product naam</div>
                <div class="col">Voorraad</div>
                <div class="col">Voorgestelde Hoeveelheid</div>
                <div class="col">Daadwerkelijk bestelde hoeveelheid</div>
				<div class="col">Bestel Groote Leverancier</div>
				<div class="col">Leverancier</div>
            </div>

            <div class="row">
                <div class="col-md-3">
                    <form method="get">
                        <div class="input-group mb-3">
                            <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Zoek op productnaam..." />
                            <button class="btn btn-light" type="submit">Zoeken</button>
                        </div>
                    </form>
                </div>
            </div>
            
            <form method="post">
                @foreach (var item in Model.OrderList)
                {
                    var tekort = item.DesiredStock - item.StockQuantity;
                    var voorgesteld = (int)Math.Ceiling((double)tekort / item.SupplierValue) * item.SupplierValue;

                    <div class="row bg-secondary text-light rounded py-2 mb-2">
                        <div class="col">@item.Name</div>
                        <div class="col">@item.StockQuantity</div>
                        <div class="col">@voorgesteld</div>
                        <div class="col">
                            <input type="number" name="OrderedQuantities[@item.Id]" value="@item.OrderedStock" min="0" step="@item.SupplierValue" class="form-control" />
                        </div>
                        <div class="col">@item.SupplierValue</div>
                        <div class="col">@item.Supplier</div>
                    </div>
                }
                    
                <button type="submit" class="btn btn-success mt-3">Bestelling Plaatsen</button>
            </form>

        </div>
    </div>
</div>

