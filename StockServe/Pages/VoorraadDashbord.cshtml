@page
@model StockServe.Pages.VoorraadDashbordModel
@{
}
        <div class="container-fluid bg-dark text-light p-3" style="height: 100vh;">
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @Model.ErrorMessage
                </div>
	}

            <div class="row h-100">
                <!-- Sidebar -->
                <div class="col-md-3 bg-secondary text-center rounded p-3">
                    <h2>Menu</h2>
                    <div class="d-grid gap-2 my-3">
                        <button class="btn btn-light" onclick="location.href='VoorraadDashbord'">Voorraad</button>
                        <button class="btn btn-light" onclick="location.href='Bestellijst'">Bestellijst</button>
                        <button class="btn btn-light" onclick="location.href='bezorgLijst'">Word Bezorgt</button>
				        <button class="btn btn-light" onclick="location.href='VoorraadAanpassen'">Pas Voorraad Aan</button>
                    </div>
                </div>

                <!-- Main Content -->
                <div class="col-md-9 bg-dark rounded p-3">
                    <div class="row fw-bold text-light border-bottom pb-2 mb-3">
                        <div class="col-md-3">Product naam</div>
                        <div class="col">Voorraad</div>
                        <div class="col">Drempelwaarde</div>
                        <div class="col">Gewenste hoeveelheid</div>
                        <div class="col">Percentage</div>
                    </div>

                    <!-- Zoekformulier direct onder 'Product naam' met juiste breedte -->
                    <div class="row">
                        <div class="col-md-3">
                            <form method="get">
                                <div class="input-group mb-3">
                                    <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Zoek op productnaam..." />
                                    <button class="btn btn-light" type="submit">Zoeken</button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Voorraadlijst -->
                    @foreach (var stock in Model.StockItems)
                    {
                        var percentage = (stock.DesiredStock == 0 ? 0 : (int)((double)stock.StockQuantity / stock.DesiredStock * 100));

                        <div class="row bg-secondary text-light rounded py-2 mb-2">
                            <div class="col-md-3">@stock.Name</div>
                            <div class="col">@stock.StockQuantity</div>
                            <div class="col">@stock.MinimumStock</div>
                            <div class="col">@stock.DesiredStock</div>
                            <div class="col">@percentage%</div>
                        </div>
                    }
                </div>
            </div>
        </div>
